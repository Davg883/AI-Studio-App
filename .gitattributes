# Normalise line endings: store LF in the repo and check out LF on every OS,
# regardless of each contributor's core.autocrlf setting.
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets: never touch line endings or attempt text diffs
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.pptx binary
*.docx binary
*.xlsx binary
*.mp4  binary
*.mov  binary
*.mp3  binary
*.wav  binary
*.woff binary
*.woff2 binary
