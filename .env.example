# Studio Operator - Environment Configuration
# All model API keys remain server-side only

# Server Execution Mode
NEXT_PUBLIC_APP_ENV=development
# Default operator name recorded on approvals and sign-offs (can be changed per browser in the Studio menu)
NEXT_PUBLIC_OPERATOR_NAME=
# Set to 'true' to use simulated GPT-6 Astra and Higgsfield generation models (no API keys required)
MOCK_MODE=true

# AI Provider Keys (for live production runs)
OPENAI_API_KEY=
# GPT-6 Astra / Custom Endpoint (if utilizing custom gateway)
ASTRA_API_BASE_URL=https://api.openai.com/v1

# Higgsfield API (Cinematic Image, Video, Motion, Camera Control & Audio)
# Format: Key ID and Secret from console.higgsfield.ai
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# Or single credentials string: KEY_ID:KEY_SECRET
HF_CREDENTIALS=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# Voice & Finishing API (ElevenLabs / Audio finishing)
ELEVENLABS_API_KEY=

# Studio Fee Defaults (in %)
DEFAULT_CHANNEL_FEE_PCT=10
DEFAULT_CONTINGENCY_PCT=15

